          "id": "1a266e09-907f-41b0-832f-b58f27a1b8ea",
          "name": "Get Meter",
          "request": {
            "name": "Get Meter",
            "description": {
              "content": "Return ``{plan, used, cap, over_cap, org_id}`` for an org.\n\nAuthorization:\n  * Static (admin) keys may query any org.\n  * Per-customer keys may only query their own org -- the principal's\n    ``org_id`` is the source of truth; a mismatch with the query\n    param is rejected.\n  * JWT (dashboard) callers must have ``org_id`` in their\n    ``allowed_orgs``.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "billing",
                "meter"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "org_id",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "days",
                  "value": "0",
                  "description": "If >0, include per-day timeseries for the trailing N days."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "API key (EventSource fallback)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "6760d822-c9be-4afe-a614-6591cdc5c7e7",
