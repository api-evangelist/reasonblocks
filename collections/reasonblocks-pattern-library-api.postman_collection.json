          "name": "List Patterns",
          "request": {
            "name": "List Patterns",
            "description": {
              "content": "List patterns scoped to the caller's tenant.\n\nPer-customer keys: only their own E1 patterns. E2/E3 are commons /\nuniversal so they're returned to anyone (no per-tenant data).\nStatic keys: optional ``?org_id=`` filter; otherwise all patterns.\nJWT (dashboard): must pass ``?org_id=`` and the org must be in\n``allowed_orgs``.",
              "type": "text/plain"
            },
            "url": {
