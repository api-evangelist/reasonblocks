{
  "opencollection": "1.0.0",
  "info": {
    "name": "ReasonBlocks Billing Patterns & Traces API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Patterns & Traces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Traces",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/traces/retrieve",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "API key (EventSource fallback)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve raw pattern payloads for a tier, optionally filtered."
        },
        {
          "info": {
            "name": "Store Trace",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/traces",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "API key (EventSource fallback)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Store a completed trace for future distillation."
        }
      ]
    }
  ],
  "bundled": true
}